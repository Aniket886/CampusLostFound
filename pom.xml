<?xml version="1.0" encoding="UTF-8"?>
<!--
  Optional Maven build (PRD 11.2 / 15.4: "run without Eclipse").
  Eclipse ignores this file unless you convert the project to Maven.
    mvn jetty:run      -> http://localhost:8080/CampusLostFound/
    mvn clean package  -> target/CampusLostFound.war (copy into tomcat/webapps)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.campus</groupId>
    <artifactId>CampusLostFound</artifactId>
    <version>1.0</version>
    <packaging>war</packaging>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>          <!-- supplied by Tomcat / Jetty -->
        </dependency>
        <!-- MySQL Connector/J is already in src/main/webapp/WEB-INF/lib, so it is packaged from there -->
    </dependencies>

    <build>
        <finalName>CampusLostFound</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>
            <plugin>
                <groupId>org.eclipse.jetty.ee10</groupId>
                <artifactId>jetty-ee10-maven-plugin</artifactId>
                <version>12.0.15</version>
                <configuration>
                    <webApp>
                        <contextPath>/CampusLostFound</contextPath>
                    </webApp>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
